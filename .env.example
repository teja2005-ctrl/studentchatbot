# EduBot — Environment Variables
# Copy this file to .env and fill in your values
# .env is listed in .gitignore and will NOT be committed to Git

# ── REQUIRED ──────────────────────────────────────────────
# Your Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── OPTIONAL (proxy server only) ──────────────────────────
# Port for the Python proxy server (default: 5000)
PORT=5000

# Enable Flask debug mode (true/false) — use false in production
FLASK_DEBUG=false
